{
  "name": "whatsapp-linux",
  "version": "1.0.0",
  "description": "WhatsApp para Linux com interface estilo Discord",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder",
    "dist": "npm run build && electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.whatsapp.linux",
    "productName": "WhatsApp Linux",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Network",
      "icon": "assets/icon.png"
    }
  },
  "keywords": [
    "whatsapp",
    "linux",
    "discord",
    "baileys"
  ],
  "author": "Você",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "axios": "^1.8.0",
    "express": "^4.21.0",
    "ffmpeg-static": "^5.3.0",
    "jimp": "^1.6.1",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7",
    "ws": "^8.18.0"
  }
}
